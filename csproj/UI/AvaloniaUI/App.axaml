<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FakeMessenger.UI.AvaloniaUI.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        
        <!-- Скрывает панель навигации у всех ContentPage внутри NavigationPage -->
        <Style Selector="NavigationPage ContentPage">
            <Setter Property="NavigationPage.HasNavigationBar" Value="False" />
            <Setter Property="NavigationPage.HasBackButton" Value="False" />
        </Style>
    </Application.Styles>
</Application>