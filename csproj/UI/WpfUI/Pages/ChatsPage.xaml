<Page x:Class="FakeMessenger.UI.WpfUI.Pages.ChatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="clr-namespace:FakeMessenger.UI.WpfUI.Models"
      Title="Чаты">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Margin="20,24,20,16">
            <TextBlock Text="Чаты"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button Style="{StaticResource IconButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="+"
                    ToolTip="Создать чат"
                    Click="CreateChatButton_Click"/>
        </Grid>

        <!-- Поиск -->
        <Grid Grid.Row="1" Margin="20,0,20,12">
            <TextBox x:Name="SearchBox"
                     Style="{StaticResource InputBox}"
                     TextChanged="SearchBox_TextChanged"/>

            <TextBlock x:Name="SearchPlaceholder"
                       Text="Поиск"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="15,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <!-- Список чатов -->
        <ListBox x:Name="ChatsList"
                 Grid.Row="2"
                 Margin="8,0,8,12"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource ChatListBoxItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="ChatsList_SelectionChanged">

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ChatItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="48"
                                Height="48"
                                CornerRadius="24"
                                Background="{StaticResource SurfaceAltBrush}">
                            <TextBlock Text="{Binding AvatarText}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding LastMessage}"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Time}"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Right"/>

                            <Border Background="{StaticResource AccentBrush}"
                                    CornerRadius="9"
                                    Height="18"
                                    MinWidth="18"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding UnreadCount}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="5,0"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>