<Page x:Class="FakeMessenger.UI.WpfUI.Pages.ChatSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Чаты">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Мои чаты" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" />

        <ListView Grid.Row="1" x:Name="ChatsListView" 
                  MouseDoubleClick="ChatsListView_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ChatName}" Foreground="Gray" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Создать чат" Click="CreateChat_Click" Margin="5,0,0,0" Padding="10,5" />
            <Button Content="Создать контакт" Click="CreateContact_Click" Margin="5,0,0,0" Padding="10,5" />
            <Button Content="Сохранить данные" Click="Save_Click" Margin="5,0,0,0" Padding="10,5" />
            <Button Content="Загрузить данные" Click="Load_Click" Margin="5,0,0,0" Padding="10,5" />
        </StackPanel>
    </Grid>
</Page>