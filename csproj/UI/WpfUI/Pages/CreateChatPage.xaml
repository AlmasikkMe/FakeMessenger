<Page x:Class="FakeMessenger.UI.WpfUI.Pages.CreateChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Новый чат">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Margin="20,24,20,16">
            <Button Style="{StaticResource IconButton}"
                    HorizontalAlignment="Left"
                    Content="←"
                    ToolTip="Назад"
                    Click="BackButton_Click"/>

            <TextBlock Text="Новый чат"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Форма -->
        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <TextBlock Text="Название"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="13"
                       Margin="2,0,0,6"/>
            <TextBox x:Name="ChatNameBox" Style="{StaticResource InputBox}"/>

            <TextBlock Text="Тип чата"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="13"
                       Margin="2,20,0,4"/>

            <RadioButton x:Name="PrivateRadio"
                         Style="{StaticResource OptionRadio}"
                         Content="Личный"
                         GroupName="ChatType"
                         IsChecked="True"/>

            <RadioButton x:Name="GroupRadio"
                         Style="{StaticResource OptionRadio}"
                         Content="Группа"
                         GroupName="ChatType"/>

            <RadioButton x:Name="ChannelRadio"
                         Style="{StaticResource OptionRadio}"
                         Content="Канал"
                         GroupName="ChatType"/>

            <TextBlock Text="Участники"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="13"
                       Margin="2,20,0,6"/>
            <TextBox x:Name="MembersBox" Style="{StaticResource InputBox}"/>

            <TextBlock Text="Имена через запятую"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Margin="2,6,0,0"/>
        </StackPanel>

        <!-- Действие -->
        <Button Grid.Row="2"
                Style="{StaticResource AccentButton}"
                Content="Создать"
                Margin="20,0,20,20"
                Click="CreateButton_Click"/>
    </Grid>
</Page>