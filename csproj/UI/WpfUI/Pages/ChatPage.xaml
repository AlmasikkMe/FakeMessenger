<Page x:Class="FakeMessenger.UI.WpfUI.Pages.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="clr-namespace:FakeMessenger.UI.WpfUI.Models"
      Title="Чат">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка чата -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource IconButton}"
                        Content="←"
                        ToolTip="Назад"
                        Click="BackButton_Click"/>

                <Border Grid.Column="1"
                        Width="40"
                        Height="40"
                        CornerRadius="20"
                        Margin="10,0,0,0"
                        Background="{StaticResource SurfaceAltBrush}">
                    <TextBlock x:Name="HeaderAvatar"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle"
                               FontWeight="SemiBold"
                               FontSize="15"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HeaderStatus"
                               Text="в сети"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Лента сообщений -->
        <ScrollViewer x:Name="MessagesScroll"
                      Grid.Row="1"
                      Padding="16,12"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="MessagesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:MessageItem}">
                        <Border x:Name="Bubble"
                                MaxWidth="280"
                                Margin="0,4"
                                Padding="12,8"
                                CornerRadius="14"
                                HorizontalAlignment="Left"
                                Background="{StaticResource BubbleInBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="BubbleTime"
                                           Text="{Binding Time}"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Bubble" Property="Background" Value="{StaticResource BubbleOutBrush}"/>
                                <Setter TargetName="BubbleTime" Property="Foreground" Value="{StaticResource BubbleOutTimeBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Панель ввода -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageBox"
                         Grid.Column="0"
                         Style="{StaticResource InputBox}"
                         KeyDown="MessageBox_KeyDown"/>

                <Button Grid.Column="1"
                        Style="{StaticResource AccentButton}"
                        Content="Отправить"
                        Margin="8,0,0,0"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>