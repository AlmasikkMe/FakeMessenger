<Page x:Class="FakeMessenger.UI.WpfUI.Pages.CreateContactPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Новый контакт">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Новый контакт" FontSize="24" FontWeight="Bold" Margin="0,0,0,15" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="Имя пользователя (@...):" Margin="0,0,0,5" />
            <TextBox x:Name="UsernameTextBox" Padding="5" Margin="0,0,0,10" />

            <TextBlock Text="Имя:" Margin="0,0,0,5" />
            <TextBox x:Name="FirstNameTextBox" Padding="5" Margin="0,0,0,10" />

            <TextBlock Text="Фамилия:" Margin="0,0,0,5" />
            <TextBox x:Name="LastNameTextBox" Padding="5" Margin="0,0,0,15" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Назад" Click="Back_Click" Margin="0,0,10,0" Padding="15,5" />
            <Button Content="Создать" Click="Create_Click" Padding="15,5" />
        </StackPanel> 
    </Grid>
</Page>